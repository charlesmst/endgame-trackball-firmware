#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/* Fire the msc tick at 4ms — before the 5ms sensor-rotate tap window closes.
 * 4000 * 4ms/1000 = 16: one scroll step per detent (dongle resolution multiplier = 15). */
&msc {
    trigger-period-ms = <4>;
};

&mkp_input_listener { input-processors = <&esb_ip>; };
&msc_input_listener { input-processors = <&esb_ip>; };

/ {
    behaviors {
        /* Zero-param wrappers so hold-tap can bind them with #binding-cells = <2>. */
        bt_nxt: bt_nxt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr: bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        /* Tap: cycle to next BLE profile.  Hold 3s: clear bonds on current profile. */
        dpi_btn: dpi_btn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <3000>;
            flavor = "tap-preferred";
            bindings = <&bt_clr>, <&bt_nxt>;
        };

        scroll: scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(-250)>, <&msc MOVE_Y(250)>;
        };
    };

    mou0_mmv_il {
        compatible = "zmk,input-listener";
        device = <&mou0>;
        input-processors = <&esb_ip>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK
                &mkp RCLK
                &mkp MCLK
                &mkp MB4
                &mkp MB5
                &dpi_btn 0 0
            >;
            sensor-bindings = <&scroll>;
        };
    };
};
